# ==============================================================================
# ASTERLEAF SCHOOL ERP — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and fill in the values for your environment.
# DO NOT commit real secrets or service-role keys to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local embedded PostgreSQL default:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/school_erp

# Fresh Supabase Project Connection (choose one):
# Option A: Supabase Transaction Pooler (Recommended for serverless & high scale, Port 6543)
# DATABASE_URL=postgres://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Option B: Supabase Direct Connection (Session Mode, Port 5432)
DATABASE_URL=postgres://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# SSL mode for PostgreSQL connections (defaults to true for non-local connections)
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS
# ------------------------------------------------------------------------------
# Public Supabase Project URL
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase Public Anonymous Key (safe for browser client-side calls)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Supabase Service-Role Key (STRICTLY for backend migrations / administrative tasks)
# NEVER expose this key to browser bundles, public repositories, or frontend code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# ------------------------------------------------------------------------------
# 3. APPLICATION & API SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Hosted pilot only. Set the explicit UTC expiry in ISO format (including milliseconds).
# TRIAL_EXPIRES_AT=2026-12-09T10:00:00.000Z
# Or set TRIAL_EXPIRY_FILE to the private console-created file for this instance.

# Session cookie lifetime in days
SESSION_TTL_DAYS=7

# Set to "true" in production when serving over HTTPS
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. EXTERNAL NOTIFICATIONS & GATEWAYS (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional external notification delivery (Email / SMS / WhatsApp gateway).
# If unset, notifications are recorded in the internal audit outbox without simulated delivery.
# NOTIFICATION_PROVIDER_URL=https://gateway.example.com/send
# NOTIFICATION_PROVIDER_TOKEN=your-token-here
# NOTIFICATION_PROVIDER_NAME=webhook

# Password reset email sender (Hostinger Email; leave unset to disable recovery email).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-mailbox@yourdomain.com
# SMTP_PASSWORD=your-mailbox-password
# SMTP_FROM=your-mailbox@yourdomain.com

# Temporary one-time recovery gate. Remove after the two Digivista admin
# accounts have been bootstrapped; the database also records completion.
# ADMIN_BOOTSTRAP_SECRET=generate-a-random-secret-at-least-32-characters-long

# Required for biometric-template cryptography. Provision a unique secret outside source control.
# 64 hexadecimal characters (32 random bytes); no shared fallback is supplied.
BIOMETRIC_ENCRYPTION_KEY=
# Browser-generated embeddings/liveness are synthetic test inputs. Production face
# enrollment/punch endpoints remain disabled until a trusted inference integration exists.
